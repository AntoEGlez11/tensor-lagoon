rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId); // Explicitly allow creation
      // Admins can read and write all profiles
      allow read, write: if isAdmin();

      // Vehicles Subcollection
      match /vehicles/{vehicleId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }
    }

    // Services collection (Tickets)
    match /services/{serviceId} {
      // Admins have full access
      allow read, write: if isAdmin();
      
      // Customers can read their own services
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid);
      
      // Customers can create tickets
      allow create: if isAuthenticated() && 
                      request.resource.data.customerId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      // Validate essential fields
                      request.resource.data.vehicle is string &&
                      request.resource.data.vehicle.size() > 0 &&
                      request.resource.data.package is string;
    }

    // Service Offerings (Catalog)
    match /service-offerings/{offeringId} {
      allow read: if true;
      allow write: if isAdmin() && 
                    (!request.resource.data.keys().hasAny(['price']) || request.resource.data.price is string) &&
                    (!request.resource.data.keys().hasAny(['title']) || request.resource.data.title.size() > 0);
    }
    
    // Testimonials
    match /testimonials/{tId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appointments (Booking System)
    match /appointments/{apptId} {
      allow read: if true; // Public needs to read to check availability
      allow create: if true; // Public can request appointments
      allow delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid && 
                     (request.resource.data.status == 'pending' || request.resource.data.status == 'cancelled'));
    }
  }
}
